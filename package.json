{
  "name": "@abstractplay/betza",
  "version": "1.0.0-beta",
  "description": "A Betza notation parser",
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    }
  },
  "scripts": {
    "build": "npm run build-ts && npm run test:postbuild && npm run lint",
    "build-ts": "tsc && npm pack",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run typecheck",
    "test:postbuild": "node scripts/smoke-package-entry.mjs",
    "test": "mocha",
    "lint": "npx eslint .",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "repository": {
    "type": "git",
    "url": "AbstractPlay/betza"
  },
  "author": "Aaron Dalton <aaron@daltons.ca> (https://www.perlkonig.com/)",
  "license": "MIT",
  "engines": {
    "node": ">=24",
    "npm": "11.6.2"
  },
  "packageManager": "npm@11.6.2",
  "keywords": [
    "abstractplay",
    "games",
    "betza",
    "chess"
  ],
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@types/chai": "^4.3.4",
    "@types/mocha": "^10.0.10",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "chai": "^4.3.7",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-unicorn": "^59.0.1",
    "json-schema-to-typescript": "^15.0.4",
    "mocha": "^11.2.2",
    "prettier": "^3.7.4",
    "tsx": "^4.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0"
  }
}
